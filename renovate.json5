{
  extends: [
    "github>suzuki-shunsuke/renovate-config#4.0.0",
    "github>suzuki-shunsuke/renovate-config:nolimit#4.0.0",
    "github>suzuki-shunsuke/renovate-config:go-directive#4.0.0",
    "github>aquaproj/aqua-renovate-config#2.15.0",
    "github>aquaproj/aqua-renovate-config:file#2.15.0(aqua/imports/.*\\.ya?ml)",
  ],
  packageRules: [
    {
      // bradleyfalzon/ghinstallation/v2 exposes golang-jwt/jwt/v4 types in its API (Signer, NewRSASigner),
      // so jwt v5 can't be used until ghinstallation migrates to it.
      matchPackageNames: ["github.com/golang-jwt/jwt/v4"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
  ],
}
